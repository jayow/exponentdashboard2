# Helius RPC keys — dual-key concurrency for the extractor
HELIUS_KEY_1=
HELIUS_KEY_2=

# Optional fallback / generic Solana RPC
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Warehouse location (override if you want it outside the repo)
WAREHOUSE_PATH=./data/warehouse.duckdb

# Extractor knobs
EXTRACT_BATCH_SIZE=100
EXTRACT_CONCURRENCY=12
EXTRACT_RETRY_MAX=5
