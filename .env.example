# Comma-separated Solana JSON-RPC endpoint URLs. The client round-robins
# across them with per-endpoint concurrency + retries. Any provider works:
# Helius, QuickNode, Chainstack, Alchemy, public RPC, your own node.
# Example:
#   SOLANA_RPC_URLS=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY,https://other.example/?key=ABC
SOLANA_RPC_URLS=

# Warehouse location (override if you want it outside the repo)
WAREHOUSE_PATH=./data/warehouse.duckdb

# Extractor knobs
EXTRACT_BATCH_SIZE=100
EXTRACT_CONCURRENCY=12
EXTRACT_RETRY_MAX=5
